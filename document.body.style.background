function showWelcome() {
  document.getElementById('welcome-text').innerHTML = 'أهلاً بيك في صفحتي البحثية! نورت الصفحة ❤️';
  alert('أهلاً بيك في صفحتي!');
}

function changeColor() {
  let colors = ['#f0f2f5', '#ffe0e0', '#e0ffe0', '#e0eaff', '#fff5cc'];
  let random = Math.floor(Math.random() * colors.length);
  document.body.style.background = colors[random];
}

function toggleSection() {
  let section = document.getElementById('conclusion');
  if (section.style.display === 'none') {
    section.style.display = 'block';
  } else {
    section.style.display = 'none';
  }
}
